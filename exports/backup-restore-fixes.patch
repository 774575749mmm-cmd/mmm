+              updated_by_user_id = EXCLUDED.updated_by_user_id,
+              updated_at = NOW()
+          `,
+            [
+              resolvedTargetCompanyId,
+              schemaVersion,
+              savedRevision,
+              JSON.stringify(profilePayload),
