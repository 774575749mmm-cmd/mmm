+          `,
+            [
+              resolvedTargetCompanyId,
+              cleanNameAr,
+              cleanNameEn,
+              cleanCountryCode,
+              cleanBaseCurrency,
+              cleanValuation,
+              cleanCommercial,
+              cleanTax,
+              cleanPhone,
+              cleanEmail,
+              cleanAddress,
